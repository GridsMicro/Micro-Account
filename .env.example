# ============================================================
# Micro Account — Environment Variables Template
# บริษัท ไมโครทรอนิก (ไทยแลนด์) จำกัด
# ============================================================
# คัดลอกไฟล์นี้เป็น .env.local แล้วใส่ค่าจริงของคุณ
# cp .env.example .env.local
# ⚠️ ห้าม Commit .env.local ขึ้น GitHub เด็ดขาด!
# ============================================================

# -----------------------------------------------
# 1. DATABASE (Neon PostgreSQL)
# สร้างได้ที่: https://neon.tech
# -----------------------------------------------
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# -----------------------------------------------
# 2. GOOGLE OAUTH 2.0 (Google Drive File Picker)
# สร้างได้ที่: https://console.cloud.google.com/apis/credentials
# → Create Credentials → OAuth 2.0 Client ID → Web application
# -----------------------------------------------
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_ID=your_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your_client_secret
GOOGLE_REFRESH_TOKEN=1//your_refresh_token
GOOGLE_REDIRECT_URI=https://your-domain.vercel.app/api/auth/callback/google

# -----------------------------------------------
# 3. GOOGLE API KEY (Google Picker API)
# สร้างได้ที่: https://console.cloud.google.com/apis/credentials
# → Create Credentials → API Key
# ⚠️ จำกัด Key ให้ใช้ได้แค่ Google Drive API + Google Picker API
# -----------------------------------------------
NEXT_PUBLIC_GOOGLE_API_KEY=AIzaSy_your_api_key

# -----------------------------------------------
# 4. GMAIL (ส่งอีเมลอัตโนมัติ — ใช้สำหรับลืมรหัสผ่าน)
# สร้าง App Password: https://myaccount.google.com/apppasswords
# ต้องเปิด 2-Step Verification ก่อน
# โค้ดส่งผ่าน smtp.gmail.com:465 (implicit TLS) ด้วย Node tls — ไม่ต้องติดตั้ง nodemailer
# ถ้าไม่ตั้งค่าทั้ง 2 ตัว /api/auth/forgot-password จะตอบ 503 แทนการปลอมความสำเร็จ
# ⚠️ ห้าม commit ค่าจริงลง git
# -----------------------------------------------
GMAIL_FROM=noreply@your-domain.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# -----------------------------------------------
# 4.1 TAX NOTIFICATION (แจ้งเตือนภาษี → LINE Messaging API)
# ⚠️ LINE Notify ยุติบริการ 31 มี.ค. 2025 แล้ว — ใช้ Messaging API แทน
# สร้าง Official Account + เปิด Messaging API: https://developers.line.biz/console/
# Channel Access Token (long-lived) อยู่ในแท็บ "Messaging API" ของ OA
# มาตรฐานเดียว: LINE_CHANNEL_ID = ปลายทางที่ใช้ส่ง · LINE_CHANNEL_ACCESS_TOKEN = token
# (ค่าจากพี่ฆัง — โค้ดอ่านชื่อสองตัวนี้เท่านั้น ไม่มีชื่อสำรอง)
# ถ้าไม่ตั้ง token/ID ระบบจะ fallback ไป Discord (ถ้ามี) หรือ log แทน
# DISCORD_WEBHOOK_URL = ทางสำรอง ใช้เมื่อ LINE ส่งไม่สำเร็จ
# ⚠️ ห้าม commit ค่าจริง / ห้าม hardcode ในโค้ด
# -----------------------------------------------
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_ID=
DISCORD_WEBHOOK_URL=
# วันที่ส่งแจ้งเตือนในแต่ละเดือน (ค่าเริ่มต้นในโค้ด: 1,10,14,20,22)
# ไม่ต้องตั้งบน Vercel — ถ้าไม่ตั้ง โค้ดใช้ค่านี้เอง
TAX_LINE_REMINDER_DAYS=1,10,14,20,22
# route /api/cron/tax-line — ต้องตั้ง true ใน Vercel Dashboard ถึงจะส่งจริง
# safety switch: ไม่ตั้ง/ตั้งค่าอื่น = cron เรียกแล้วข้าม (dry-run ใช้ ?dry=1&force=1 ไม่ต้องเปิด)
TAX_LINE_CRON_ENABLED=false
# CRON_SECRET = รหัสที่ Vercel ส่งมาใน Authorization header (ตั้งใน Vercel Dashboard)
# route จะตอบ 401 ถ้าไม่มีค่านี้ — fail-closed
CRON_SECRET=

# -----------------------------------------------
# 4.2 RD OPEN API (ยื่นแบบ/ซิงค์สถานะกับกรมสรรพากร — 2026-11-18)
# สมัครใช้งานที่ efiling.rd.go.th → ต้องยื่น ภ.อ.01.2 + ทำข้อตกลง
# และใช้ใบรับรอง NRCA ตามที่กรมกำหนด (ดู docs/OPERATION_RUNBOOK.md)
# ⚠️ ห้าม commit credential จริง / ห้าม hardcode
# ถ้าไม่ตั้งค่า ฟังก์ชัน RD ทั้งหมดจะคืน success:false (ไม่มีผลลวง)
# -----------------------------------------------
RD_EFILING_USERNAME=OA1-xxxxxxxxxxxxx
RD_EFILING_PASSWORD=your_rd_openapi_password
RD_EFILING_SENDER_ID=OA1-xxxxxxxxxxxxx
# 1 = ผู้มีหน้าที่เสียอากร (ตัวแทนของบริษัทตัวเอง), 2 = ผู้ให้บริการตัวแทน
RD_EFILING_ROLE=1
# ปล่อยว่าง = ใช้ https://efiling.rd.go.th/rd-cms
RD_EFILING_BASE_URL=https://efiling.rd.go.th/rd-cms
# version ของแบบ ภ.พ.30 — ตรวจกับ technical spec ก่อนเปลี่ยน
RD_EFILING_PP30_VERSION=1.0.0

# -----------------------------------------------
# 5. NEXTAUTH (ระบบ Login จริง)
# สร้าง Secret ด้วย: openssl rand -base64 32
# Session Duration: เป็นวินาที (24 ชม = 86400 วินาที)
# -----------------------------------------------
NEXTAUTH_URL=https://your-domain.vercel.app
NEXTAUTH_SECRET=your_random_secret_32_chars
SESSION_MAX_AGE=86400

# -----------------------------------------------
# 6. SEED DATA (สำหรับเตรียมข้อมูลเริ่มต้น)
# ⚠️ ใช้เพื่อสร้างผู้ใช้ admin เท่านั้น
# ⚠️ หลังจากสร้างแล้วควรแก้ไขรหัสผ่าน และลบค่าเหล่านี้
# -----------------------------------------------
# Email ของ Admin (ค่าเริ่มต้น: admin@microtronic.biz)
SEED_ADMIN_EMAIL=admin@microtronic.biz

# ชื่อ Admin (ค่าเริ่มต้น: Administrator)
SEED_ADMIN_NAME=Administrator

# รหัสผ่าน Admin (ค่าเริ่มต้น: admin123) ⚠️ ใช้ตัวอักษรที่ปลอดภัย
SEED_ADMIN_PASSWORD=admin123

# Role ของ Admin (ค่าเริ่มต้น: Administrator)
SEED_ADMIN_ROLE=Administrator

# -----------------------------------------------
# 7. LICENSE (License Verification Middleware)
# สร้าง Salt ด้วย: openssl rand -base64 48
# ⚠️ จำเป็น ระบบจะ fail-fast ถ้าไม่ตั้งค่า (P2-01)
# -----------------------------------------------
LICENSE_SALT=your_random_salt_base64
